{
  "name": "box-deckspitter",
  "version": "1.1.2",
  "description": "Box-Deckspitter — a self-hosted document, PDF, text and code editor that runs entirely on your PC.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "app": "electron electron/main.js",
    "browser": "node server.js --open",
    "postinstall": "node -e \"const fs=require('fs'),j=require('path').join;for(const[p,n,ds,k]of[['monaco-editor','min/vs/loader.js',['dev','esm','min-maps']],['pdf-lib','dist/pdf-lib.min.js',['es','cjs','src','ts3.4'],'pdf-lib.min.js'],['@cantoo/pdf-lib','cjs/index.js',['es','src','ts3.4'],'']])try{const b=j('node_modules',p);if(!fs.existsSync(j(b,n))||fs.lstatSync(b).isSymbolicLink())continue;for(const d of ds)fs.rmSync(j(b,d),{recursive:true,force:true});if(k!=null)for(const f of fs.readdirSync(j(b,'dist')))if(f.startsWith('pdf-lib')&&f!==k)fs.rmSync(j(b,'dist',f),{force:true})}catch(e){}\""
  },
  "author": "boxbind (Discord: @boxbind)",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/inter": "5.2.5",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "docx": "9.5.0",
    "electron": "44.4.5",
    "imapflow": "2.1.0",
    "jszip": "3.10.1",
    "mailparser": "3.9.29",
    "marked": "15.0.12",
    "monaco-editor": "0.52.2",
    "nodemailer": "10.0.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0",
    "xlsx": "0.18.5"
  }
}
