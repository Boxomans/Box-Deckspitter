# Downloaded libraries + the Electron runtime (~670 MB). `npm install` brings them back.
node_modules/

# Personal data: settings, recent files, drafts, version history, API key, Gmail app passwords,
# clipboard history, window cache. Never commit this folder.
data/

# Your files in the dumps (the app recreates the empty folders on start).
image-dump/
media-dump/
doc-dump/
audio-dump/
mend-dump/

# Machine-specific shortcuts and tools
*.lnk
.claude/

# OS / editor clutter
Thumbs.db
Desktop.ini
.DS_Store
*.log
